# Copy to .env and fill in. NEVER commit .env.

# ---------- LLM ----------
# LLM_PROVIDER: anthropic | openrouter | openai | groq
#   (openai also covers other OpenAI-compatible endpoints via OPENAI_BASE_URL: Gemini, Ollama ...)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Max output tokens per LLM call. Lower it if OpenRouter returns HTTP 402 (not enough credits).
LLM_MAX_TOKENS=4096

ANTHROPIC_API_KEY=

# OpenRouter: LLM_PROVIDER=openrouter, LLM_MODEL=openai/gpt-4.1-mini (any model id from
# https://openrouter.ai/models). The endpoint is set automatically.
OPENROUTER_API_KEY=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Groq: LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-120b (endpoint is set automatically)
GROQ_API_KEY=

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=breast-cancer-classifier
MLFLOW_REGISTERED_MODEL=breast-cancer-classifier

# ---------- Airflow 3 ----------
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
# DAGs the agent is allowed to trigger (comma separated)
AIRFLOW_ALLOWED_DAGS=training_pipeline

# ---------- Kubernetes ----------
K8S_NAMESPACE=mlops-agent
# Namespaces in which the agent may perform state-changing operations
K8S_ALLOWED_NAMESPACES=mlops-agent
K8S_APP_LABEL=app=ml-inference
# Leave empty to use the default kubeconfig (~/.kube/config)
KUBECONFIG=

# ---------- DVC ----------
REPO_ROOT=.

# ---------- Agent ----------
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=10
RETRAIN_FRESHNESS_DAYS=30
RETRAIN_MIN_F1=0.90
LOG_LEVEL=INFO

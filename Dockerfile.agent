# MLOps Copilot agent API image.
# DVC tools operate on a git checkout of this repository, mounted at /repo at runtime:
#   docker run -p 8001:8001 --env-file .env -v "$PWD:/repo" -v "$HOME/.kube:/home/agent/.kube:ro" mlops-agent
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 REPO_ROOT=/repo \
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0=*
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home agent
WORKDIR /app
COPY pyproject.toml README.md ./
COPY agent ./agent
COPY api ./api
RUN pip install --no-cache-dir ".[tools,llm]" "dvc>=3.50"
USER 10001
EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health')"
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8001"]
